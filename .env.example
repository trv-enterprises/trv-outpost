# TRV Outpost — environment configuration
#
# This file is OPTIONAL. The defaults in docker-compose.deploy.yml
# already produce a working dashboard at http://localhost.
#
# Copy and edit only if you want to customize:
#   cp .env.example .env

# =============================================================================
# IMAGE / RELEASE
# =============================================================================

# Pin to a specific version, or leave as `latest` for the most recent
# tagged release. See https://github.com/trv-enterprises/trve-dashboard/releases
# IMAGE_TAG=v0.10.0

# =============================================================================
# NETWORKING
# =============================================================================

# Domain Caddy serves on. `localhost` is fine for evaluation; switch
# to your real hostname (e.g. `dashboard.example.com`) for a public
# deployment and Caddy will request a Let's Encrypt cert automatically.
# Public DNS + ports 80/443 reachable from the internet are required
# for cert issuance. Do NOT use a bare IP for HTTPS — the IP-SAN cert is
# rejected by Chrome/Firefox; use a hostname (via /etc/hosts or DNS).
# DOMAIN=localhost

# Optional TLS directive injected into the Caddyfile, for HTTPS cert
# sources that aren't public ACME. Empty by default (today's behavior).
# Caddy substitutes it verbatim, so a multi-line value is fine. Examples:
#   - Tailscale (.ts.net) cert — publicly trusted, zero browser warning;
#     needs tailscaled reachable from the container + tailnet HTTPS certs on:
#       DOMAIN=<node>.<tailnet>.ts.net
#       CADDY_TLS_DIRECTIVE="tls { get_certificate tailscale }"
#   - Internal CA cert for an intranet hostname (one-time per-device trust):
#       CADDY_TLS_DIRECTIVE="tls internal"
# CADDY_TLS_DIRECTIVE=

# Override host ports (defaults: 80 / 443). Useful if those are taken.
#
# Caveat: Caddy builds its HTTP→HTTPS redirect from DOMAIN and does not
# know about a remap, so with HTTPS_PORT=8443 a hit on http://localhost:8080/
# redirects to https://localhost/ (bare 443) and goes nowhere. Browse
# directly to the HTTPS port — https://localhost:8443/ — instead.
# HTTP_PORT=8080
# HTTPS_PORT=8443

# =============================================================================
# AI BUILDER (optional)
# =============================================================================

# Anthropic API key — enables the AI chart builder. Without this,
# the dashboard works fully; the AI Builder option is just hidden.
# Get a key at https://console.anthropic.com/.
# ANTHROPIC_API_KEY=sk-ant-api03-…

# =============================================================================
# LOGIN — you must configure ONE of the two options below
# =============================================================================
#
# docker-compose.deploy.yml ships secure-by-default: Clerk unset AND
# legacy GUID auth off. That combination leaves NO credential channel,
# so the stack comes up healthy but cannot be signed into
# (/api/auth/session returns 401, UI shows "login not configured").
# API keys don't help — minting one requires an existing admin session.

# --- Option 1: Clerk sign-in (recommended for anything reachable) ---
#
# Set BOTH to enable Clerk-backed browser sign-in (email + Google +
# Apple, etc.). See udoc/docs/clerk-sso.md for the setup walkthrough.
# CLERK_SECRET_KEY=sk_test_…
# CLERK_PUBLISHABLE_KEY=pk_test_…

# --- Option 2: legacy GUID auth (localhost evaluation only) ---
#
# Don't set this var by hand — use the ready-made overlay, which also
# confines the ports to loopback (the two must go together):
#
#   docker compose -f docker-compose.deploy.yml \
#                  -f docker-compose.localhost.yml up -d
#
# It enables the ?user_id=<guid> / X-User-ID identity channel described
# in udoc/docs/getting-started.md. That is identity ASSERTION, not
# authentication: it trusts ANY GUID presented to it. Anyone who can
# reach the port becomes any user they name.
#
# Setting the var alone, without the overlay, leaves the Caddy ports on
# 0.0.0.0 and exposes that open door to your whole LAN/tailnet.

# =============================================================================
# EXTERNAL CONNECTIVITY (optional, advanced)
# =============================================================================

# host:port the server can be reached at from outside the docker
# network — only needed if you have an external service (e.g.
# ts-store) that dials back to this server's inbound WebSocket.
# Leave empty for the standard quickstart.
# DASHBOARD_HOST=192.168.1.10:3001
