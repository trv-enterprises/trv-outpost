{
  "schema_version": "1",
  "chart_type": "banded_bar",
  "library": "echarts",
  "display": {
    "label": "Banded Bar Chart",
    "icon": "ChartLineData",
    "description": "Levey-Jennings / control-chart style — time-series with per-row mean + SD bands"
  },
  "capabilities": {
    "requires_x_axis": true,
    "requires_y_axis": false,
    "multiple_y_axis": false,
    "single_axis_n_columns": false,
    "has_pivot_series": false,
    "has_axis_labels": false,
    "has_x_axis_format": true,
    "has_time_bucket": false,
    "has_sort_limit": false,
    "has_visible_columns": false,
    "has_filters": true,
    "has_aggregation": false,
    "has_sliding_window": false,
    "has_legend_config": true,
    "has_tooltip_config": true,
    "has_axis_range": true,
    "has_thresholds": false
  },
  "sections": [
    {
      "id": "data_mapping",
      "label": "Data Mapping",
      "subsections": [
        {
          "id": "timestamp_group",
          "label": "Timestamp",
          "layout": "row-4",
          "fields": [
            {
              "id": "x_axis_column",
              "binds": "data_mapping.x_axis",
              "type": "column_select",
              "label": "Timestamp column",
              "required": true,
              "helperText": "The horizontal (time) axis. One column per row."
            },
            {
              "id": "x_axis_format",
              "binds": "data_mapping.x_axis_format",
              "type": "enum",
              "label": "Timestamp format",
              "default": "chart",
              "options": [
                { "value": "chart", "label": "Auto (date + time)" },
                { "value": "chart_time", "label": "Time only" },
                { "value": "chart_date", "label": "Date only" },
                { "value": "raw", "label": "Raw value" }
              ]
            }
          ]
        },
        {
          "id": "band_columns_group",
          "label": "Band Columns",
          "helperText": "Pick a band scheme, then map each band to a per-row column. Each row carries its own band values, so the envelope moves with the data. Only the center column is required.",
          "layout": "single-column",
          "fields": [
            {
              "id": "band_scheme",
              "binds": "data_mapping.band_columns",
              "type": "band_scheme",
              "label": "Band scheme"
            }
          ]
        }
      ]
    },
    {
      "id": "chart_options",
      "label": "Chart Options",
      "subsections": [
        {
          "id": "style_group",
          "label": "Visual style",
          "layout": "single-column",
          "fields": [
            {
              "id": "banded_bar_style",
              "binds": "options.bandedBarStyle",
              "type": "enum",
              "label": "Visual style",
              "default": "time_series",
              "options": [
                { "value": "time_series", "label": "Time Series — line + dots, full-width bands (default)" },
                { "value": "column_filled", "label": "Column (filled) — vertical column per timestamp, no borders" },
                { "value": "column_outlined", "label": "Column (outlined) — vertical column with band borders" },
                { "value": "column_box", "label": "Column (box) — inner band only, line with tick at value" }
              ]
            }
          ]
        },
        {
          "id": "display",
          "label": "Display",
          "helperText": "Smooth / markers apply to the center line (Time Series style).",
          "layout": "row-4",
          "fields": [
            {
              "id": "chart_smooth",
              "binds": "options.chartSmooth",
              "type": "boolean",
              "label": "Smooth curves",
              "default": true
            },
            {
              "id": "chart_show_zoom_slider",
              "binds": "options.chartShowZoomSlider",
              "type": "boolean",
              "label": "Zoom slider",
              "default": false
            },
            {
              "id": "show_symbol",
              "binds": "options.showSymbol",
              "type": "boolean",
              "label": "Show point markers",
              "default": true,
              "helperText": "Turn off for dense time series to get a clean line."
            },
            {
              "id": "x_axis_label_rotate",
              "binds": "options.xAxisLabelRotate",
              "type": "enum",
              "label": "X-axis label angle",
              "helperText": "Rotate x-axis labels so long timestamps fit better.",
              "default": 0,
              "options": [
                { "value": 0, "label": "Horizontal" },
                { "value": 30, "label": "30°" },
                { "value": 45, "label": "45°" },
                { "value": 90, "label": "Vertical (90°)" }
              ]
            }
          ]
        },
        {
          "id": "perf",
          "label": "Performance",
          "helperText": "Downsampling for the center line on ≥10k-point series. LTTB preserves visual shape; average/max preserve statistics.",
          "layout": "row-4",
          "fields": [
            {
              "id": "sampling",
              "binds": "options.sampling",
              "type": "enum",
              "label": "Downsampling",
              "default": "off",
              "options": [
                { "value": "off", "label": "Off (render every point)" },
                { "value": "lttb", "label": "LTTB (perceptual)" },
                { "value": "average", "label": "Average" },
                { "value": "max", "label": "Max" }
              ]
            }
          ]
        },
        {
          "id": "y_axis_range_left",
          "label": "Y-axis range",
          "helperText": "Auto scales to the band extent; set manual bounds to pin the axis.",
          "layout": "row-4",
          "fields": [
            {
              "id": "y_left_min",
              "binds": "options.yAxisRange.left.min",
              "type": "nullable_number",
              "label": "Min",
              "default": null,
              "step": 1
            },
            {
              "id": "y_left_max",
              "binds": "options.yAxisRange.left.max",
              "type": "nullable_number",
              "label": "Max",
              "default": null,
              "step": 1
            },
            {
              "id": "y_left_scale",
              "binds": "options.yAxisRange.left.scale",
              "type": "enum",
              "label": "Scale",
              "default": "linear",
              "options": [
                { "value": "linear", "label": "Linear" },
                { "value": "log", "label": "Logarithmic" }
              ]
            }
          ]
        },
        {
          "id": "tooltip_config",
          "label": "Tooltip",
          "helperText": "Mode toggles the tooltip on hover; Decimals + Units format the band values inside.",
          "layout": "row-4",
          "fields": [
            {
              "id": "tooltip_mode",
              "binds": "options.tooltip.mode",
              "type": "enum",
              "label": "Mode",
              "default": "multi",
              "options": [
                { "value": "multi", "label": "Shown" },
                { "value": "hidden", "label": "Hidden" }
              ]
            },
            {
              "id": "tooltip_decimals",
              "binds": "options.tooltip.decimals",
              "type": "nullable_number",
              "label": "Decimals",
              "default": null,
              "min": 0,
              "max": 10,
              "step": 1
            },
            {
              "id": "tooltip_units",
              "binds": "options.tooltip.units",
              "type": "text",
              "label": "Units suffix",
              "default": "",
              "placeholder": "e.g. %, °C, MB/s"
            }
          ]
        },
        {
          "id": "legend_config",
          "label": "Legend",
          "helperText": "Shows a key for the Mean / ±1 SD / ±2 SD bands.",
          "layout": "row-4",
          "fields": [
            {
              "id": "legend_show",
              "binds": "options.legend.show",
              "type": "boolean",
              "label": "Show legend",
              "default": true
            },
            {
              "id": "legend_position",
              "binds": "options.legend.position",
              "type": "enum",
              "label": "Position",
              "default": "top",
              "helperText": "Left/right reserve ~135px of plot width for the legend column.",
              "options": [
                { "value": "top", "label": "Top" },
                { "value": "bottom", "label": "Bottom" },
                { "value": "left", "label": "Left" },
                { "value": "right", "label": "Right" }
              ],
              "visibleWhen": { "field": "legend_show", "operator": "truthy" }
            }
          ]
        }
      ]
    }
  ]
}
