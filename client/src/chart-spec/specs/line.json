{
  "schema_version": "1",
  "chart_type": "line",
  "library": "echarts",
  "display": {
    "label": "Line Chart",
    "icon": "ChartLine",
    "description": "Show trends over time"
  },
  "capabilities": {
    "requires_x_axis": true,
    "requires_y_axis": true,
    "multiple_y_axis": true,
    "single_axis_n_columns": true,
    "has_pivot_series": true,
    "has_axis_labels": true,
    "has_x_axis_format": true,
    "has_time_bucket": true,
    "has_sort_limit": true,
    "has_visible_columns": false,
    "has_filters": true,
    "has_aggregation": true,
    "has_sliding_window": true,
    "has_legend_config": true,
    "has_tooltip_config": true,
    "has_axis_range": true,
    "has_thresholds": true
  },
  "derived_fields": [
    {
      "id": "any_accumulator",
      "description": "Injected by ComponentEditor formState: true when any y_axis_columns entry has Δ Delta (accumulate) ticked. Gates the Accumulator subsection."
    }
  ],
  "sections": [
    {
      "id": "data_mapping",
      "label": "Data Mapping",
      "subsections": [
        {
          "id": "x_axis_group",
          "label": "X-axis",
          "layout": "row-4",
          "fields": [
            {
              "id": "x_axis_column",
              "binds": "data_mapping.x_axis",
              "type": "column_select",
              "label": "X-axis column",
              "required": true,
              "helperText": "Usually a timestamp."
            },
            {
              "id": "x_axis_label",
              "binds": "data_mapping.x_axis_label",
              "type": "text",
              "label": "X-axis label",
              "default": "",
              "placeholder": "Leave empty to hide"
            },
            {
              "id": "x_axis_format",
              "binds": "data_mapping.x_axis_format",
              "type": "enum",
              "label": "Timestamp format",
              "default": "auto",
              "options": [
                { "value": "auto", "label": "Auto (fits the data)" },
                { "value": "chart", "label": "Date + Time (1/15 10:30)" },
                { "value": "chart_time", "label": "Time Only (10:30 AM)" },
                { "value": "chart_time_seconds", "label": "Time + Seconds (10:30:05 AM)" },
                { "value": "chart_date", "label": "Date Only (Jan 15)" },
                { "value": "chart_datetime", "label": "Full (Jan 15, 10:30 AM)" },
                { "value": "chart_datetime_seconds", "label": "Full + Seconds (Jan 15, 10:30:05 AM)" }
              ]
            }
          ]
        },
        {
          "id": "y_axis_group",
          "label": "Y-axis",
          "layout": "single-column",
          "fields": [
            {
              "id": "multipleYAxis",
              "binds": "data_mapping.multiple_y_axis",
              "type": "boolean",
              "label": "Dual Y-axis",
              "default": false,
              "helperText": "Off: all series on one axis (N allowed). On: split across left/right axes (capped at 2 series). Each axis takes its series label as the axis label."
            },
            {
              "id": "y_axis_label",
              "binds": "data_mapping.y_axis_label",
              "type": "text",
              "label": "Y-axis label",
              "visibleWhen": { "field": "multipleYAxis", "operator": "falsy" },
              "helperText": "Rendered vertically along the axis. Distinct from series labels, which name each value-set in the legend."
            },
            {
              "id": "y_axis_columns",
              "binds": "data_mapping.y_axis",
              "type": "y_axis_columns_list",
              "label": "Series",
              "required": true,
              "helperText": "Numeric columns to plot, one series each. The series label overrides what appears in the legend (and, in dual-axis mode, on that side's axis); leave empty to use the data column name. Use In-stack to stack a subset of series (series left out draw independently, stack-free — useful for a high-water total line). Tick Δ Delta on a series whose values are a monotonically-increasing counter (odometer, packet/request total, kWh meter) to plot its per-interval change instead of the raw ramp.",
              "modeFieldId": "multipleYAxis",
              "maxInDualAxis": 2,
              "showAccumulator": true
            }
          ]
        },
        {
          "id": "series_group",
          "label": "Pivot",
          "helperText": "Use a column's distinct values to split one value column into multiple series — e.g. a `location` column with warehouse/north/south produces three series. Leave empty when every series is already its own column.",
          "layout": "row-4",
          "fields": [
            {
              "id": "series_column",
              "binds": "data_mapping.series",
              "type": "column_select",
              "label": "Pivot by column"
            }
          ]
        },
        {
          "id": "accumulator_group",
          "label": "Accumulator",
          "helperText": "Counter-reset handling for any Y column with Δ Delta ticked above.",
          "layout": "single-column",
          "visibleWhen": { "field": "any_accumulator", "operator": "truthy" },
          "fields": [
            {
              "id": "accumulator_reset_policy",
              "binds": "data_mapping.accumulator_reset_policy",
              "type": "enum",
              "label": "Counter-reset handling",
              "default": "drop_negative",
              "options": [
                { "value": "drop_negative", "label": "Break the line (drop resets)" },
                { "value": "clamp_zero", "label": "Show 0 at resets" },
                { "value": "keep_negative", "label": "Show the negative delta" }
              ],
              "helperText": "When a Δ counter resets (a negative delta): break the line, show 0, or surface the raw negative drop."
            }
          ]
        }
      ]
    },
    {
      "id": "chart_options",
      "label": "Chart Options",
      "subsections": [
        {
          "id": "display",
          "label": "Display",
          "layout": "row-4",
          "fields": [
            {
              "id": "chart_smooth",
              "binds": "options.chartSmooth",
              "type": "boolean",
              "label": "Smooth curves",
              "default": true
            },
            {
              "id": "chart_show_data_labels",
              "binds": "options.chartShowDataLabels",
              "type": "boolean",
              "label": "Data labels",
              "default": false
            },
            {
              "id": "chart_si_prefixes",
              "binds": "options.chartSiPrefixes",
              "type": "boolean",
              "label": "Abbreviate large values (SI)",
              "helperText": "Show large numbers with SI prefixes and 3 significant digits (14,340,393,939 → 14.3G). All labels on an axis share one prefix.",
              "default": true
            },
            {
              "id": "chart_show_zoom_slider",
              "binds": "options.chartShowZoomSlider",
              "type": "boolean",
              "label": "Zoom slider",
              "default": false
            },
            {
              "id": "show_symbol",
              "binds": "options.showSymbol",
              "type": "boolean",
              "label": "Show point markers",
              "default": true,
              "helperText": "Turn off for dense time series to get a clean line."
            },
            {
              "id": "x_axis_label_rotate",
              "binds": "options.xAxisLabelRotate",
              "type": "enum",
              "label": "X-axis label angle",
              "helperText": "Rotate x-axis labels so long category names fit better. Best for charts with few categories; with many categories ECharts still thins labels to avoid overlap.",
              "default": 0,
              "options": [
                { "value": 0, "label": "Horizontal" },
                { "value": 30, "label": "30°" },
                { "value": 45, "label": "45°" },
                { "value": 90, "label": "Vertical (90°)" }
              ]
            }
          ]
        },
        {
          "id": "perf",
          "label": "Performance",
          "helperText": "Downsampling for ≥10k-point series. LTTB preserves visual shape; average/max preserve statistics.",
          "layout": "row-4",
          "fields": [
            {
              "id": "sampling",
              "binds": "options.sampling",
              "type": "enum",
              "label": "Downsampling",
              "default": "off",
              "options": [
                { "value": "off", "label": "Off (render every point)" },
                { "value": "lttb", "label": "LTTB (perceptual)" },
                { "value": "average", "label": "Average" },
                { "value": "max", "label": "Max" }
              ]
            }
          ]
        },
        {
          "id": "y_axis_range_left",
          "label": "Left Y-axis range",
          "helperText": "Auto lets the axis library scale to the data; uncheck to set manual bounds.",
          "layout": "row-4",
          "fields": [
            {
              "id": "y_left_min",
              "binds": "options.yAxisRange.left.min",
              "type": "nullable_number",
              "label": "Min",
              "default": null,
              "step": 1
            },
            {
              "id": "y_left_max",
              "binds": "options.yAxisRange.left.max",
              "type": "nullable_number",
              "label": "Max",
              "default": null,
              "step": 1
            },
            {
              "id": "y_left_scale",
              "binds": "options.yAxisRange.left.scale",
              "type": "enum",
              "label": "Scale",
              "default": "linear",
              "options": [
                { "value": "linear", "label": "Linear" },
                { "value": "log", "label": "Logarithmic" }
              ]
            }
          ]
        },
        {
          "id": "y_axis_range_right",
          "label": "Right Y-axis range",
          "helperText": "Only used when Dual Y-axis is on.",
          "layout": "row-4",
          "visibleWhen": { "field": "multipleYAxis", "operator": "truthy" },
          "fields": [
            {
              "id": "y_right_min",
              "binds": "options.yAxisRange.right.min",
              "type": "nullable_number",
              "label": "Min",
              "default": null,
              "step": 1
            },
            {
              "id": "y_right_max",
              "binds": "options.yAxisRange.right.max",
              "type": "nullable_number",
              "label": "Max",
              "default": null,
              "step": 1
            },
            {
              "id": "y_right_scale",
              "binds": "options.yAxisRange.right.scale",
              "type": "enum",
              "label": "Scale",
              "default": "linear",
              "options": [
                { "value": "linear", "label": "Linear" },
                { "value": "log", "label": "Logarithmic" }
              ]
            }
          ]
        },
        {
          "id": "tooltip_config",
          "label": "Tooltip",
          "helperText": "Mode controls when the tooltip appears on hover; Decimals + Units format the values inside.",
          "layout": "row-4",
          "fields": [
            {
              "id": "tooltip_mode",
              "binds": "options.tooltip.mode",
              "type": "enum",
              "label": "Mode",
              "default": "multi",
              "options": [
                { "value": "multi", "label": "All series" },
                { "value": "single", "label": "Single series" },
                { "value": "hidden", "label": "Hidden" }
              ]
            },
            {
              "id": "tooltip_decimals",
              "binds": "options.tooltip.decimals",
              "type": "nullable_number",
              "label": "Decimals",
              "default": null,
              "min": 0,
              "max": 10,
              "step": 1
            },
            {
              "id": "tooltip_units",
              "binds": "options.tooltip.units",
              "type": "text",
              "label": "Units suffix",
              "default": "",
              "placeholder": "e.g. %, °C, MB/s"
            }
          ]
        },
        {
          "id": "legend_config",
          "label": "Legend",
          "layout": "row-4",
          "fields": [
            {
              "id": "legend_show",
              "binds": "options.legend.show",
              "type": "boolean",
              "label": "Show legend",
              "default": true,
              "helperText": "When more than one series is present."
            },
            {
              "id": "legend_position",
              "binds": "options.legend.position",
              "type": "enum",
              "label": "Position",
              "default": "top",
              "helperText": "Top is the default and the recommended position. Left/right reserve ~135px of plot width for the legend column — widen the panel to compensate.",
              "options": [
                { "value": "top", "label": "Top" },
                { "value": "bottom", "label": "Bottom" },
                { "value": "left", "label": "Left" },
                { "value": "right", "label": "Right" }
              ],
              "visibleWhen": { "field": "legend_show", "operator": "truthy" }
            }
          ]
        },
        {
          "id": "thresholds_config",
          "label": "Y-axis Thresholds",
          "helperText": "Reference lines or color stops at specific Y values. Each threshold has a value, color, and optional label.",
          "layout": "single-column",
          "fields": [
            {
              "id": "y_thresholds",
              "binds": "options.yThresholds",
              "type": "threshold_list",
              "label": "Thresholds"
            }
          ]
        },
        {
          "id": "thresholds_render_mode_group",
          "label": "Threshold rendering",
          "layout": "row-4",
          "visibleWhen": { "field": "y_thresholds", "operator": "not_empty" },
          "fields": [
            {
              "id": "y_threshold_render_mode",
              "binds": "options.yThresholdRenderMode",
              "type": "enum",
              "label": "Render as",
              "default": "line",
              "options": [
                { "value": "line", "label": "Reference line at value" },
                { "value": "color_segments", "label": "Color the line by value" },
                { "value": "both", "label": "Both" }
              ]
            }
          ]
        }
      ]
    }
  ]
}
