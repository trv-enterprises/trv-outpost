{
  "schema_version": "1",
  "chart_type": "value",
  "library": "react",
  "display": {
    "label": "Value",
    "icon": "StringInteger",
    "description": "A single value — number or text — rendered large with an optional unit"
  },
  "capabilities": {
    "requires_x_axis": false,
    "requires_y_axis": true,
    "multiple_y_axis": false,
    "single_axis_n_columns": false,
    "has_pivot_series": false,
    "has_axis_labels": false,
    "has_x_axis_format": false,
    "has_time_bucket": false,
    "has_sort_limit": false,
    "has_visible_columns": false,
    "has_filters": true,
    "has_aggregation": true,
    "has_sliding_window": false,
    "has_latest_by": false,
    "has_legend_config": false,
    "has_tooltip_config": false,
    "has_axis_range": false,
    "has_thresholds": false
  },
  "sections": [
    {
      "id": "data_mapping",
      "label": "Data Mapping",
      "subsections": [
        {
          "id": "value_group",
          "label": "Value",
          "helperText": "Shows the first row's value for this column (after any aggregation).",
          "layout": "row-4",
          "fields": [
            {
              "id": "value_column",
              "binds": "data_mapping.y_axis[0]",
              "type": "column_select",
              "label": "Value column",
              "required": true,
              "helperText": "Column to display. Numeric or text."
            }
          ]
        }
      ]
    },
    {
      "id": "chart_options",
      "label": "Value Options",
      "subsections": [
        {
          "id": "value_type_group",
          "label": "Value type",
          "layout": "row-2",
          "fields": [
            {
              "id": "value_type",
              "binds": "options.valueType",
              "type": "enum",
              "label": "Value type",
              "default": "auto",
              "helperText": "Auto reads the type from the sampled data and is right nearly always. Set it explicitly when the sample is empty, mixed, or a live stream hasn't produced a record yet — the options below follow this choice.",
              "options": [
                { "value": "auto", "label": "Auto — detect from data" },
                { "value": "number", "label": "Number" },
                { "value": "text", "label": "Text" }
              ]
            },
            {
              "id": "value_source_unit",
              "binds": "options.valueSourceUnit",
              "type": "enum",
              "label": "Source unit",
              "default": "none",
              "helperText": "What the stored number already is, not how it's displayed. A megabytes column holding 123,456 is 123.5G once scaled; left at None, Compact SI reports 123.5k. Pick Binary (KiB/MiB) for memory and filesystem stats, Decimal (KB/MB) for disk and network figures.",
              "visibleWhen": {
                "field": "value_type",
                "operator": "not_in",
                "value": ["text"]
              },
              "options": [
                { "value": "none", "label": "None — base units already" },
                { "value": "k", "label": "Kilo (KB, decimal ×1,000)" },
                { "value": "M", "label": "Mega (MB, decimal ×1e6)" },
                { "value": "G", "label": "Giga (GB, decimal ×1e9)" },
                { "value": "T", "label": "Tera (TB, decimal ×1e12)" },
                { "value": "Ki", "label": "Kibi (KiB, binary ×1,024)" },
                { "value": "Mi", "label": "Mebi (MiB, binary ×1024²)" },
                { "value": "Gi", "label": "Gibi (GiB, binary ×1024³)" },
                { "value": "Ti", "label": "Tebi (TiB, binary ×1024⁴)" }
              ]
            }
          ]
        },
        {
          "id": "value_style_numeric",
          "label": "Display",
          "helperText": "The format implies the raw value's unit — pick Duration when the value is seconds, Date/Time when it's a timestamp — so no query math is needed.",
          "layout": "row-4",
          "visibleWhen": {
            "field": "value_type",
            "operator": "not_in",
            "value": ["text"]
          },
          "fields": [
            {
              "id": "value_format",
              "binds": "options.valueFormat",
              "type": "enum",
              "label": "Format",
              "default": "auto",
              "options": [
                { "value": "auto", "label": "Auto (source precision)" },
                { "value": "plain", "label": "Plain number (1,234.5)" },
                { "value": "compact", "label": "Compact SI (1.2M, 3.4G)" },
                { "value": "duration", "label": "Duration from seconds (2d 3h 4m)" },
                { "value": "duration_clock", "label": "Duration clock (HH:MM:SS)" },
                { "value": "datetime", "label": "Date / time (value is a timestamp)" }
              ]
            },
            {
              "id": "value_size",
              "binds": "options.valueSize",
              "type": "enum",
              "label": "Value size (px)",
              "default": "56",
              "options": [
                { "value": "12", "label": "12 px" },
                { "value": "14", "label": "14 px" },
                { "value": "16", "label": "16 px" },
                { "value": "20", "label": "20 px" },
                { "value": "24", "label": "24 px" },
                { "value": "32", "label": "32 px" },
                { "value": "40", "label": "40 px" },
                { "value": "48", "label": "48 px" },
                { "value": "56", "label": "56 px" },
                { "value": "64", "label": "64 px" },
                { "value": "80", "label": "80 px" },
                { "value": "96", "label": "96 px" },
                { "value": "120", "label": "120 px" },
                { "value": "160", "label": "160 px" },
                { "value": "200", "label": "200 px" },
                { "value": "240", "label": "240 px" },
                { "value": "300", "label": "300 px" },
                { "value": "400", "label": "400 px" }
              ]
            },
            {
              "id": "value_decimals",
              "binds": "options.valueDecimals",
              "type": "enum",
              "label": "Decimal places",
              "default": "auto",
              "helperText": "Auto keeps the source precision (up to 2 places).",
              "options": [
                { "value": "auto", "label": "Auto" },
                { "value": "0", "label": "0" },
                { "value": "1", "label": "1" },
                { "value": "2", "label": "2" },
                { "value": "3", "label": "3" },
                { "value": "4", "label": "4" }
              ]
            },
            {
              "id": "value_unit",
              "binds": "options.valueUnit",
              "type": "text",
              "label": "Unit suffix",
              "default": "",
              "placeholder": "e.g. °F, %, psi",
              "helperText": "Rendered inline after the value, same size. With a source unit set, use the BASE unit (B, not MB) — the prefix comes from the value."
            }
          ]
        },
        {
          "id": "value_date_style",
          "label": "Date / time style",
          "layout": "row-4",
          "visibleWhen": {
            "field": "value_format",
            "operator": "eq",
            "value": "datetime"
          },
          "fields": [
            {
              "id": "value_date_format",
              "binds": "options.valueDateFormat",
              "type": "enum",
              "label": "Date/time style",
              "default": "datetime",
              "helperText": "Only used when Format is Date / time.",
              "options": [
                { "value": "date", "label": "Date (Jan 15)" },
                { "value": "time", "label": "Time (10:30 AM)" },
                { "value": "time_seconds", "label": "Time + seconds (10:30:05 AM)" },
                { "value": "datetime", "label": "Date + time (Jan 15, 10:30 AM)" },
                { "value": "datetime_seconds", "label": "Date + time + seconds" }
              ]
            }
          ]
        },
        {
          "id": "value_thresholds_numeric",
          "label": "Color thresholds",
          "layout": "full-width",
          "visibleWhen": {
            "field": "value_type",
            "operator": "not_in",
            "value": ["text"]
          },
          "fields": [
            {
              "id": "value_threshold_target",
              "binds": "options.valueThresholdTarget",
              "type": "radio",
              "label": "Apply color to",
              "default": "text",
              "helperText": "Where a matched threshold's color lands. Only background fills the tile and derives a readable text color automatically. Text and background fills the tile AND colors the value with the threshold color — only legible on a light fill. When no threshold matches, the tile falls back to the Background color set below.",
              "options": [
                { "value": "text", "label": "Text" },
                { "value": "both", "label": "Text and background" },
                { "value": "background", "label": "Only background" }
              ]
            },
            {
              "id": "value_thresholds",
              "binds": "options.valueThresholds",
              "type": "threshold_list",
              "label": "Thresholds",
              "helperText": "Color the value by how large it is. Each threshold's color applies from its value upward, so the highest one the value reaches wins. Leave empty for the default text color."
            }
          ]
        },
        {
          "id": "value_style_text",
          "label": "Display",
          "helperText": "Text values render as-is. Decimal places and unit suffix don't apply to text, so they aren't shown here.",
          "layout": "row-4",
          "visibleWhen": {
            "field": "value_type",
            "operator": "eq",
            "value": "text"
          },
          "fields": [
            {
              "id": "value_text_case",
              "binds": "options.valueTextCase",
              "type": "enum",
              "label": "Text case",
              "default": "none",
              "helperText": "Applied to the rendered string only — the source data is unchanged.",
              "options": [
                { "value": "none", "label": "As-is (source)" },
                { "value": "upper", "label": "ALL CAPS" },
                { "value": "lower", "label": "lowercase" },
                { "value": "capitalize", "label": "Capitalize First Letter" },
                { "value": "title", "label": "Title Case" }
              ]
            },
            {
              "id": "value_size_text",
              "binds": "options.valueSize",
              "type": "enum",
              "label": "Value size (px)",
              "default": "56",
              "options": [
                { "value": "12", "label": "12 px" },
                { "value": "14", "label": "14 px" },
                { "value": "16", "label": "16 px" },
                { "value": "20", "label": "20 px" },
                { "value": "24", "label": "24 px" },
                { "value": "32", "label": "32 px" },
                { "value": "40", "label": "40 px" },
                { "value": "48", "label": "48 px" },
                { "value": "56", "label": "56 px" },
                { "value": "64", "label": "64 px" },
                { "value": "80", "label": "80 px" },
                { "value": "96", "label": "96 px" },
                { "value": "120", "label": "120 px" },
                { "value": "160", "label": "160 px" },
                { "value": "200", "label": "200 px" },
                { "value": "240", "label": "240 px" },
                { "value": "300", "label": "300 px" },
                { "value": "400", "label": "400 px" }
              ]
            }
          ]
        },
        {
          "id": "value_thresholds_text_group",
          "label": "Color rules",
          "layout": "full-width",
          "visibleWhen": {
            "field": "value_type",
            "operator": "eq",
            "value": "text"
          },
          "fields": [
            {
              "id": "value_threshold_target_text_field",
              "binds": "options.valueThresholdTarget",
              "type": "radio",
              "label": "Apply color to",
              "default": "text",
              "helperText": "Where a matched rule's color lands. Only background fills the tile and derives a readable text color automatically — the usual pick for a status tile that should read green/red at a glance. When no rule matches, the tile falls back to the Background color set below.",
              "options": [
                { "value": "text", "label": "Text" },
                { "value": "both", "label": "Text and background" },
                { "value": "background", "label": "Only background" }
              ]
            },
            {
              "id": "value_text_thresholds",
              "binds": "options.valueTextThresholds",
              "type": "text_threshold_list",
              "label": "Color rules",
              "helperText": "Color the value by what it says. Add a rule per state you care about — there is no limit. Rules are checked top to bottom and the first match wins, so put specific rules above broad ones. Matching ignores case."
            }
          ]
        },
        {
          "id": "value_background_group",
          "label": "Background",
          "helperText": "Static fill for the tile, used whenever no threshold or rule matches. The value's text color is paired automatically from Carbon's matching light/dark set, so the number stays readable. When a threshold matches and Apply color to is Background or Both, the threshold's color fills the tile instead of this one.",
          "layout": "full-width",
          "fields": [
            {
              "id": "value_background",
              "binds": "options.valueBackground",
              "type": "color_select",
              "label": "Background color",
              "default": "",
              "showsContrastPartner": true
            }
          ]
        }
      ]
    }
  ]
}
